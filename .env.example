# =============================================================================
# AI Learning Platform - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Generate RSA signing keys for local development (ignored by git):
#      ./scripts/generate-dev-keys.sh
# 2. Copy this file to .env and fill in strong, unique values for ALL required secrets:
#      cp .env.example .env
# 3. For local development (localhost-only debug ports & HTTP cookies on localhost):
#      docker compose -f docker-compose.yml -f docker-compose.dev.yml up --build
# 4. For production deployments:
#      - Set APP_ENV=production and APP_AUTH_COOKIE_SECURE=true behind HTTPS/TLS
#      - Inject JWT RSA keys via your secret manager (Docker/Kubernetes Secrets)
#      - Run with base docker-compose.yml only (internal ports stay private)
# 5. NEVER commit real credentials, production secrets, private keys, or .env!
# =============================================================================

# -----------------------------------------------------------------------------
# General Platform Configuration
# -----------------------------------------------------------------------------
APP_ENV=production
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Public Edge Port Mappings (only gateway & frontend are published by default)
# -----------------------------------------------------------------------------
FRONTEND_HOST_PORT=3000
GATEWAY_HOST_PORT=8080

# Optional local-dev-only debug ports (used only with docker-compose.dev.yml)
AUTH_HTTP_HOST_PORT=8082
PROFILE_HTTP_HOST_PORT=8083
FILE_HTTP_HOST_PORT=8084
CHAT_HTTP_HOST_PORT=8085
NOTIFICATION_HOST_PORT=8086
RAG_HTTP_HOST_PORT=8087
RAG_GRPC_HOST_PORT=9097
AUTH_GRPC_HOST_PORT=9090
PROFILE_GRPC_HOST_PORT=9091
FILE_GRPC_HOST_PORT=9094
CHAT_GRPC_HOST_PORT=9095
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
TEI_HOST_PORT=8088
AUTH_DB_HOST_PORT=5432
PROFILE_DB_HOST_PORT=5433
FILE_DB_HOST_PORT=5434
CHAT_DB_HOST_PORT=5435
RAG_DB_HOST_PORT=5436

# -----------------------------------------------------------------------------
# Public API & Gateway URLs + Cookie / CORS Policy
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080
INTERNAL_API_URL=http://api-gateway:8080/api
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# Cookie security flags (MUST be true in production behind HTTPS; overridden to false in docker-compose.dev.yml)
APP_AUTH_COOKIE_SECURE=true
APP_AUTH_COOKIE_SAME_SITE=Lax
APP_AUTH_COOKIE_DOMAIN=
# Keep false so browsers never receive raw JWT access/refresh tokens in JSON responses
APP_AUTH_EXPOSE_TOKENS_IN_BODY=false

# -----------------------------------------------------------------------------
# JWT RSA Signing & Verification Keys (REQUIRED)
# Generate locally with: ./scripts/generate-dev-keys.sh
# -----------------------------------------------------------------------------
JWT_PRIVATE_KEY_FILE=./secrets/jwt_private_key.pem
JWT_PUBLIC_KEY_FILE=./secrets/jwt_public_key.pem
APP_JWT_ISSUER=ai-learning-platform-auth
APP_JWT_AUDIENCE=ai-learning-platform-clients
APP_JWT_KEY_ID=primary
# Optional previous public key during zero-downtime RSA key rotation:
# APP_JWT_PREVIOUS_PUBLIC_KEY_LOCATION=file:/run/secrets/jwt_public_key_prev.pem

# -----------------------------------------------------------------------------
# Inter-Service gRPC Authentication Secrets (REQUIRED, >= 16 chars each)
# Generate strong random values, e.g.: openssl rand -hex 24
# -----------------------------------------------------------------------------
APP_GRPC_AUTH_SERVICE_SECRET=
APP_GRPC_PROFILE_SERVICE_SECRET=
APP_GRPC_FILE_SERVICE_SECRET=
APP_GRPC_CHAT_SERVICE_SECRET=
APP_GRPC_RAG_SERVICE_SECRET=

# -----------------------------------------------------------------------------
# Infrastructure Authentication (REQUIRED)
# Use URL-safe alphanumeric/hyphen/underscore characters for REDIS_PASSWORD
# -----------------------------------------------------------------------------
REDIS_PASSWORD=
QDRANT_API_KEY=

# -----------------------------------------------------------------------------
# Database Credentials (REQUIRED - set unique strong passwords per database)
# -----------------------------------------------------------------------------
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=

PROFILE_DB_NAME=user_profile_db
PROFILE_DB_USER=profile_user
PROFILE_DB_PASSWORD=

FILE_DB_NAME=file_service_db
FILE_DB_USER=file_user
FILE_DB_PASSWORD=

CHAT_DB_NAME=chat_service_db
CHAT_DB_USER=chat_user
CHAT_DB_PASSWORD=

RAG_DB_NAME=rag_db
RAG_DB_USER=rag_user
RAG_DB_PASSWORD=

# -----------------------------------------------------------------------------
# Event Streaming, Vector DB & Embeddings
# -----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
QDRANT_COLLECTION=rag_chunks_prod
QDRANT_VECTOR_SIZE=1024
TEI_MODEL=BAAI/bge-large-en-v1.5
STREAM_BACKEND=dual
HYBRID_SEARCH_ENABLED=true
HYBRID_RRF_K=60
HYBRID_DENSE_WEIGHT=1.0
HYBRID_BM25_WEIGHT=0.5
RERANKER_LOCAL_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
HF_TOKEN=

# -----------------------------------------------------------------------------
# RAG Encryption & Safe Key Rotation (REQUIRED, >= 32 chars or Fernet key)
# Generate a Fernet key:
#   python3 -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# -----------------------------------------------------------------------------
AI_KEY_ENCRYPTION_SECRET=
# Comma-separated list of previous secrets retained for decrypting existing keys during rotation:
AI_KEY_ENCRYPTION_PREVIOUS_SECRETS=

# -----------------------------------------------------------------------------
# External AI Model Provider API Keys
# (Set at least one for LLM reasoning and Direct AI execution)
# -----------------------------------------------------------------------------
OPENAI_API_KEY=
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Notification Service (Persistent Deduplication & SMTP)
# -----------------------------------------------------------------------------
IDEMPOTENCY_BACKEND=redis
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@ai-learning-platform.local
