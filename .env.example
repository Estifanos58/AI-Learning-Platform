# NotebookLM Environment Variables
# Copy this file to .env.local and fill in your values

# ============================================
# DEVELOPMENT (Mock Services)
# ============================================
# Leave blank to use mock services (default for development)

# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_AUTH_URL=

# ============================================
# PRODUCTION (Real API Integration)
# ============================================

# API Configuration
# NEXT_PUBLIC_API_URL=https://api.notebooklm.com

# Authentication
# NEXT_PUBLIC_AUTH0_DOMAIN=auth.notebooklm.com
# NEXT_PUBLIC_AUTH0_CLIENT_ID=your-auth0-client-id
# AUTH0_SECRET=your-auth0-secret
# AUTH0_BASE_URL=https://app.notebooklm.com

# File Storage
# NEXT_PUBLIC_STORAGE_BUCKET=notebooklm-files
# NEXT_PUBLIC_STORAGE_REGION=us-east-1
# STORAGE_ACCESS_KEY=your-access-key
# STORAGE_SECRET_KEY=your-secret-key

# Database
# DATABASE_URL=postgresql://user:password@localhost/notebooklm

# Analytics
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# NEXT_PUBLIC_MIXPANEL_TOKEN=your-token

# Feature Flags
# NEXT_PUBLIC_ENABLE_PDF_UPLOAD=true
# NEXT_PUBLIC_ENABLE_AI_CHAT=true
# NEXT_PUBLIC_ENABLE_FILE_SHARING=true

# Application
# NEXT_PUBLIC_APP_NAME=NotebookLM
# NEXT_PUBLIC_APP_DOMAIN=notebooklm.com
# NEXT_PUBLIC_SUPPORT_EMAIL=support@notebooklm.com
