# =============================================================================
# AI Learning Platform - Environment Configuration Template
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env before starting containers:
#      cp .env.example .env
# 2. Update secrets, database passwords, and provider API keys for your environment.
# 3. NEVER commit real credentials, production secrets, or .env to version control!
# =============================================================================

# -----------------------------------------------------------------------------
# General Platform Configuration
# -----------------------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# Host Port Mappings (External Access)
# -----------------------------------------------------------------------------
FRONTEND_HOST_PORT=3000
GATEWAY_HOST_PORT=8080
NOTIFICATION_HOST_PORT=8086
RAG_HTTP_HOST_PORT=8087
RAG_GRPC_HOST_PORT=9097
AUTH_GRPC_HOST_PORT=9090
PROFILE_GRPC_HOST_PORT=9091
FILE_GRPC_HOST_PORT=9094
CHAT_GRPC_HOST_PORT=9095
REDIS_HOST_PORT=6379
KAFKA_HOST_PORT=9092
QDRANT_HOST_PORT=6333
QDRANT_GRPC_HOST_PORT=6334
TEI_HOST_PORT=8088

# Host Ports for PostgreSQL Databases
AUTH_DB_HOST_PORT=5432
PROFILE_DB_HOST_PORT=5433
FILE_DB_HOST_PORT=5434
CHAT_DB_HOST_PORT=5435
RAG_DB_HOST_PORT=5436

# -----------------------------------------------------------------------------
# Public API & Gateway URLs (Used by Frontend)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080
GATEWAY_ALLOWED_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Inter-Service gRPC Authentication Secrets
# (Must match across microservices and API Gateway)
# -----------------------------------------------------------------------------
APP_GRPC_AUTH_SERVICE_SECRET=change-me-shared-secret-auth
APP_GRPC_PROFILE_SERVICE_SECRET=change-me-shared-secret-profile
APP_GRPC_FILE_SERVICE_SECRET=change-me-shared-secret-file
APP_GRPC_CHAT_SERVICE_SECRET=change-me-shared-secret-chat
APP_GRPC_RAG_SERVICE_SECRET=change-me-shared-secret-rag

# -----------------------------------------------------------------------------
# Database Credentials
# -----------------------------------------------------------------------------
# Auth Service Database
AUTH_DB_NAME=auth_db
AUTH_DB_USER=auth_user
AUTH_DB_PASSWORD=auth_secure_password_here

# User Profile Service Database
PROFILE_DB_NAME=user_profile_db
PROFILE_DB_USER=postgres
PROFILE_DB_PASSWORD=profile_secure_password_here

# File Service Database
FILE_DB_NAME=file_service_db
FILE_DB_USER=postgres
FILE_DB_PASSWORD=file_secure_password_here

# Chat Service Database
CHAT_DB_NAME=chat_service_db
CHAT_DB_USER=postgres
CHAT_DB_PASSWORD=chat_secure_password_here

# RAG & Direct AI Service Database
RAG_DB_NAME=rag_db
RAG_DB_USER=postgres
RAG_DB_PASSWORD=rag_secure_password_here

# -----------------------------------------------------------------------------
# Event Streaming & Vector Databases
# -----------------------------------------------------------------------------
KAFKA_CLUSTER_ID=MkU3OEVBNTcwNTJENDM2Qk
QDRANT_COLLECTION=rag_chunks_prod
HF_TOKEN=

# -----------------------------------------------------------------------------
# RAG Encryption & Key Storage Secrets (32-byte string)
# -----------------------------------------------------------------------------
RAG_ENCRYPTION_KEY=local-dev-rag-encryption-key-32-bytes
AI_KEY_ENCRYPTION_SECRET=local-dev-rag-encryption-key-32-bytes

# -----------------------------------------------------------------------------
# External AI Model Provider API Keys
# (Set at least one for LLM reasoning and Direct AI execution)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=
DEEPSEEK_API_KEY=
GROQ_API_KEY=
OPENROUTER_API_KEY=

# -----------------------------------------------------------------------------
# Email / SMTP Notification Settings
# -----------------------------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=no-reply@aiplatform.local
